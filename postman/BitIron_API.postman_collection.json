{
  "info": {
    "name": "BitIron API",
    "description": "Colección completa y actualizada de endpoints para el proyecto BitIron.\n\n**Uso:**\n1. Ejecuta 'Login' y copia el token de la respuesta.\n2. Pega el token en la variable de colección `token`.\n3. El resto de peticiones protegidas lo usarán automáticamente.\n\n**Credenciales de prueba:**\n- Admin: admin@bitiron.com / Admin1234!\n- Cliente: juan@example.com / Cliente1234!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "PON_TU_TOKEN_AQUI",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Usuario Test\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test1234!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "Registro (Error Validación)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Al\",\n  \"email\": \"correoFalsoSinArroba\",\n  \"password\": \"123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "registro"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bitiron.com\",\n  \"password\": \"Admin1234!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login (Cliente)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"Cliente1234!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Obtener Perfil (Req Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "perfil"]
            }
          }
        },
        {
          "name": "Actualizar Perfil (Req Token)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Juan Actualizado\",\n  \"objetivoFitness\": \"Ganar masa muscular\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/perfil",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "perfil"]
            }
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "item": [
        {
          "name": "Obtener Categorías",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Obtener Categoría por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "1"]
            }
          }
        },
        {
          "name": "Crear Categoría",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Nombre\": \"Nueva Categoria\",\n  \"Descripcion\": \"Descripción de prueba\",\n  \"Imagen_Url\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["categorias"]
            }
          }
        },
        {
          "name": "Actualizar Categoría",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Nombre\": \"Categoría Actualizada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "1"]
            }
          }
        },
        {
          "name": "Eliminar Categoría (con productos → error)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias/1",
              "host": ["{{baseUrl}}"],
              "path": ["categorias", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Obtener Productos (con filtros)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos?nombre=whey&idCategoria=1&page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["productos"],
              "query": [
                { "key": "nombre", "value": "whey" },
                { "key": "idCategoria", "value": "1" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Obtener Producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            }
          }
        },
        {
          "name": "Crear Producto (Req Token Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Nombre\": \"Nuevo Producto Test\",\n  \"Descripcion\": \"Prueba de creación\",\n  \"Precio\": 29.99,\n  \"Stock\": 10,\n  \"Genero\": \"unisex\",\n  \"Marca\": \"BitIron\",\n  \"ObjetivoRecomendado\": \"volumen\",\n  \"IdCategoria\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/productos",
              "host": ["{{baseUrl}}"],
              "path": ["productos"]
            }
          }
        },
        {
          "name": "Actualizar Producto (Req Token Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Precio\": 35.00,\n  \"Stock\": 20\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            }
          }
        },
        {
          "name": "Eliminar Producto (Req Token Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/productos/1",
              "host": ["{{baseUrl}}"],
              "path": ["productos", "1"]
            }
          }
        }
      ]
    },
    {
